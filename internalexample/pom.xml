<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>parent</artifactId>
        <groupId>io.mycat</groupId>
        <version>1.22-release</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>internalexample</artifactId>

    <dependencies>
        <!-- https://mvnrepository.com/artifact/com.github.stephenc.jcip/jcip-annotations -->
        <dependency>
            <groupId>com.github.stephenc.jcip</groupId>
            <artifactId>jcip-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
        </dependency>
        <dependency>
            <groupId>io.mycat</groupId>
            <artifactId>example</artifactId>
        </dependency>
        <!-- MYCAT CHANGE: 添加 hbt/proxy test 作用域。hbt 传递带入 common/config，
             供下推护栏测试离线访问 DrdsRunnerHelper/spm.MycatRouterConfig 等类。
             proxy 提供 io.mycat.config.DatasourceConfigProvider（同包跨模块类），
             MycatRouterConfig 初始化时运行时引用，server shade 未打入此新类。
             server 是 shade 库，其传递兄弟模块被剥除，必须显式声明。 -->
        <dependency>
            <groupId>io.mycat</groupId>
            <artifactId>hbt</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mycat</groupId>
            <artifactId>proxy</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- MYCAT CHANGE (I-DEBT-32-FAMILY 工程卫生): MycatTest 基类已归位到合法
                         io/mycat/drdsrunner/ 包路径, 解除 I-DEBT-② 遗留的"只编护栏测试"过窄收窄,
                         恢复编译运行合法目录下全部离线回归锁(GSI/Procedure/Rx/ScalarStd/ScalarDate/护栏)。
                         仍精确限定 include=io/mycat/drdsrunner/*.java: 非法单级带点目录
                         io.mycat.drdsrunner/ 里 20 个旧测试暂不纳入编译(其整体重组另立专轮, 见 DEBT-QUEUE)。 -->
                    <testIncludes>
                        <testInclude>io/mycat/drdsrunner/*.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>